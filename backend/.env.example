NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-cryptographically-random-value-of-at-least-32-characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-domain.example
ADMIN_URL=https://admin.your-domain.example
INITIAL_ADMIN_NAME=HAN Administrator
INITIAL_ADMIN_EMAIL=admin@your-domain.example
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
